\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Fates of foam-born throats, schematic: a lone throat's perturbation sign selects collapse or inflation (Sec.~\ref {sec:single:branching}), a pair's relative sign repulsion or attraction (Sec.~\ref {sec:pair:sign}), a repelling pair's throats inflate as it recedes (Sec.~\ref {sec:pair:recede}), and an attracting pair merges where its horizon outruns inflation (Sec.~\ref {sec:spiral:race}). Gold: horizons; right: sketched wave signals. The outcome: two fates end in a black hole, each after a single chirpless burst; in every other fate the throats inflate.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:fates}{{1}{3}{Fates of foam-born throats, schematic: a lone throat's perturbation sign selects collapse or inflation (Sec.~\ref {sec:single:branching}), a pair's relative sign repulsion or attraction (Sec.~\ref {sec:pair:sign}), a repelling pair's throats inflate as it recedes (Sec.~\ref {sec:pair:recede}), and an attracting pair merges where its horizon outruns inflation (Sec.~\ref {sec:spiral:race}). Gold: horizons; right: sketched wave signals. The outcome: two fates end in a black hole, each after a single chirpless burst; in every other fate the throats inflate}{figure.1}{}}
