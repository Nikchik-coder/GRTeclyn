\@writefile{lot}{\contentsline {table}{\numberline {VI}{\ignorespaces Size, e-folding time $\tau =5.12\,M$ (Sec.~\ref {sec:single:instability}) and time to a horizon of the fiducial throat ($R_\star =3.89\,M$) in physical units, for four ADM masses $M$. The horizon times are measured for the two added perturbations, both outward ($\varepsilon >0$, which collapses; Fig.~\ref {fig:single_throat}(c)), and bounded from above for the unperturbed throat (Sec.~\ref {sec:single:branching}). Other amplitudes follow $t_{\rm  BH}\simeq 11\,M+\tau \ln (10^{-2}/\varepsilon )$ at equal horizon radius: $22.8\,M$ at $10^{-3}$, whose first MOTS forms smaller, at $25\,M$.}}{10}{table.6}\protected@file@percent }
\newlabel{tab:scales}{{VI}{10}{Size, e-folding time $\tau =\clmTauLevelThree \,M$ (Sec.~\ref {sec:single:instability}) and time to a horizon of the fiducial throat ($R_\star =\clmRstarShort \,M$) in physical units, for four ADM masses $M$. The horizon times are measured for the two added perturbations, both outward ($\varepsilon >0$, which collapses; Fig.~\ref {fig:single_throat}(c)), and bounded from above for the unperturbed throat (Sec.~\ref {sec:single:branching}). Other amplitudes follow $t_{\rm BH}\simeq \clmHorizonTimeEpsTwo \,M+\tau \ln (10^{-2}/\varepsilon )$ at equal horizon radius: $\clmLawEpsThree \,M$ at $10^{-3}$, whose first MOTS forms smaller, at $\clmHorizonTimeEpsThree \,M$}{table.6}{}}
