\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Common-horizon properties, separation, $\max |K|$ and field maxima against time for the off-axis merger ($d=6$, tangential $p=0.10$, opposite signs, boosted, constraint-solved data). The run has four restart segments (faint dashed rules at the restart times $t=25$, $30$ and $35$): level 5, $\sigma _{\rm  KO}=1.0$, the $\chi $ floor, and level 4 to $t=100$. (a)~Areal radius and (b)~Misner--Sharp mass of the common MOTS (gold; Sec.~\ref {sec:setup:mots}); dash-dotted rules, the head-on remnant's values. Dotted rules in (a): $R_\star $ of one isolated throat and $\sqrt  2R_\star $, the radius of both throats' total area. (c)~Separation of the $\chi $ minima (grey: segment 1 past its restart time). (d)~$\max |K|$ of every run: the segments used in ink, the level-6 and level-7 restarts grey dashed, the $\sigma _{\rm  KO}=1.0$ restart grey solid; crosses mark failures. (e)~Grid maxima of $|\phi |$ (solid) and $|\Pi |$ (dashed). Gold dotted rule: horizon formation. Movie: Video~7, \href  {https://youtu.be/jNnMAXPjyRA}{\nolinkurl  {youtu.be/jNnMAXPjyRA}}. The common horizon shrinks toward the head-on remnant's radius and mass, and it swallows the field.}}{14}{figure.7}\protected@file@percent }
\newlabel{fig:spiral_collapse}{{7}{14}{Common-horizon properties, separation, $\max |K|$ and field maxima against time for the off-axis merger ($d=6$, tangential $p=\clmDSixP $, opposite signs, boosted, constraint-solved data). The run has four restart segments (faint dashed rules at the restart times $t=\clmMergerSeamOne $, $\clmMergerSeamTwo $ and $\clmMergerSeamThree $): level 5, $\sigma _{\rm KO}=1.0$, the $\chi $ floor, and level 4 to $t=100$. (a)~Areal radius and (b)~Misner--Sharp mass of the common MOTS (gold; Sec.~\ref {sec:setup:mots}); dash-dotted rules, the head-on remnant's values. Dotted rules in (a): $R_\star $ of one isolated throat and $\sqrt 2R_\star $, the radius of both throats' total area. (c)~Separation of the $\chi $ minima (grey: segment 1 past its restart time). (d)~$\max |K|$ of every run: the segments used in ink, the level-6 and level-7 restarts grey dashed, the $\sigma _{\rm KO}=1.0$ restart grey solid; crosses mark failures. (e)~Grid maxima of $|\phi |$ (solid) and $|\Pi |$ (dashed). Gold dotted rule: horizon formation. Movie: Video~7, \href {https://youtu.be/jNnMAXPjyRA}{\nolinkurl {youtu.be/jNnMAXPjyRA}}. The common horizon shrinks toward the head-on remnant's radius and mass, and it swallows the field}{figure.7}{}}
