\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The reference simulation (PM10, $N=256$) in the plane $z=0$ at $t=0$, 60, 120 and 200. Top: the sum of the weights $w_s$ of Eq.~\eqref  {eq:bary}. Bottom: $\chi -1$, positive for the negative-mass star (left, blue) and negative for the positive-mass star (right, red). Colour scales are fixed across snapshots. Circles and squares mark the cores of $\Phi _+$ and $\Phi _-$, dashed ticks the initial positions, arrows the displacement, and the number between the stars the separation $d$. Both stars move toward $+x$ at constant acceleration while $d$ stays constant to $1\%$. Movie: Video~1, \href  {https://youtu.be/egzPDbz2_B0}{\nolinkurl  {youtu.be/egzPDbz2_B0}}.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:frames}{{3}{7}{The reference simulation (PM10, $N=256$) in the plane $z=0$ at $t=0$, 60, 120 and 200. Top: the sum of the weights $w_s$ of Eq.~\eqref {eq:bary}. Bottom: $\chi -1$, positive for the negative-mass star (left, blue) and negative for the positive-mass star (right, red). Colour scales are fixed across snapshots. Circles and squares mark the cores of $\Phi _+$ and $\Phi _-$, dashed ticks the initial positions, arrows the displacement, and the number between the stars the separation $d$. Both stars move toward $+x$ at constant acceleration while $d$ stays constant to $1\%$. Movie: Video~1, \href {https://youtu.be/egzPDbz2_B0}{\nolinkurl {youtu.be/egzPDbz2_B0}}}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces (a)~Core positions of the positive-mass (solid) and negative-mass (dashed) star in the reference simulation, with the separation at three times. (b)~$\Delta X$ of PM10-t400 (solid) and one constant-acceleration fit, Eq.~\eqref  {eq:fit}, over $5\le t\le 400$ (dashed). (c)~$|\Delta X|$ of the mixed pair (black) against the core displacement of the isolated stars and the centroid displacement of the same-sign pairs (grey), on a log scale. (d)~Matter momentum of each field, $P^{(+)}$ and $P^{(-)}$, and ten times their signed total $P$ (blue; light $N=128$, dark $N=256$), Eq.~\eqref  {eq:momentum}. The pair moves three units while $P$ stays below $1\%$ of either field's momentum. Movie: Video~2, \href  {https://youtu.be/zZcr2N12aww}{\nolinkurl  {youtu.be/zZcr2N12aww}}.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:traj}{{4}{7}{(a)~Core positions of the positive-mass (solid) and negative-mass (dashed) star in the reference simulation, with the separation at three times. (b)~$\Delta X$ of PM10-t400 (solid) and one constant-acceleration fit, Eq.~\eqref {eq:fit}, over $5\le t\le 400$ (dashed). (c)~$|\Delta X|$ of the mixed pair (black) against the core displacement of the isolated stars and the centroid displacement of the same-sign pairs (grey), on a log scale. (d)~Matter momentum of each field, $P^{(+)}$ and $P^{(-)}$, and ten times their signed total $P$ (blue; light $N=128$, dark $N=256$), Eq.~\eqref {eq:momentum}. The pair moves three units while $P$ stays below $1\%$ of either field's momentum. Movie: Video~2, \href {https://youtu.be/zZcr2N12aww}{\nolinkurl {youtu.be/zZcr2N12aww}}}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Measured results against Bondi's predictions, by simulation (Table~\ref {tab:matrix}). The $C$ ratio compares a star's fitted acceleration constant $C$, in $\ddot  x=\pm C/d^2$, with its value in PM10 (Sec.~\ref {sec:scaling}).}}{8}{table.3}\protected@file@percent }
\newlabel{tab:results}{{III}{8}{Measured results against Bondi's predictions, by simulation (Table~\ref {tab:matrix}). The $C$ ratio compares a star's fitted acceleration constant $C$, in $\ddot x=\pm C/d^2$, with its value in PM10 (Sec.~\ref {sec:scaling})}{table.3}{}}
