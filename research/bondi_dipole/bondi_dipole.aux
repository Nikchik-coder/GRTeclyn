\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces (a)~Acceleration $a$ against initial separation $d_0$ at $N=128$ (circles), with a power-law fit (dashed) and $\bar  M/d^2$ (grey). (b)~$a\,d^2/\bar  M$ against $d_0$; the diamond is the $N=256$ value at $d_0=10$. (c)~$a$ against $\bar  M$ for the four equal-mass pairs at $d_0=20$, with a power-law fit (dashed) and $\bar  M/d^2$ (grey); (d)~their $a\,d^2/\bar  M$. Error bars: half the spread of fits over four disjoint time windows. The acceleration scales as $d^{-2.03\pm 0.01}$ and as $\bar  M^{0.97\pm 0.06}$.}}{9}{figure.5}\protected@file@percent }
\newlabel{fig:forcelaw}{{5}{9}{(a)~Acceleration $a$ against initial separation $d_0$ at $N=128$ (circles), with a power-law fit (dashed) and $\bar M/d^2$ (grey). (b)~$a\,d^2/\bar M$ against $d_0$; the diamond is the $N=256$ value at $d_0=10$. (c)~$a$ against $\bar M$ for the four equal-mass pairs at $d_0=20$, with a power-law fit (dashed) and $\bar M/d^2$ (grey); (d)~their $a\,d^2/\bar M$. Error bars: half the spread of fits over four disjoint time windows. The acceleration scales as $d^{-2.03\pm 0.01}$ and as $\bar M^{0.97\pm 0.06}$}{figure.5}{}}
