\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces (a)~$\ell =2$ amplitude of $\Psi _4$ on spheres of radius $R=16$, 24, 32 and 40 in PM10-L128 ($L=128$, $\Delta x=0.50$). (b)~Its mean over $150\le t\le 200$ against $R$, with the fit $\propto R^{-4.8}$ (dashed) and the $R^{-1}$ fall-off of radiation (grey). The amplitude falls far faster than radiation would, so all four spheres lie in the near zone and no radiated flux is detected.}}{10}{figure.8}\protected@file@percent }
\newlabel{fig:wavezone}{{8}{10}{(a)~$\ell =2$ amplitude of $\Psi _4$ on spheres of radius $R=16$, 24, 32 and 40 in PM10-L128 ($L=128$, $\Delta x=0.50$). (b)~Its mean over $150\le t\le 200$ against $R$, with the fit $\propto R^{-4.8}$ (dashed) and the $R^{-1}$ fall-off of radiation (grey). The amplitude falls far faster than radiation would, so all four spheres lie in the near zone and no radiated flux is detected}{figure.8}{}}
