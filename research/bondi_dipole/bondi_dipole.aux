\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces The 34 simulations. Labels name the stars, P for a positive-mass and M for a negative-mass star, followed by the initial separation $d_0$; E labels equal-mass pairs by $\bar  M$ relative to PM20, R unequal-mass pairs by $|M_-|/M_+$, and S isolated stars by $\omega $. Unless stated, a simulation uses the stars of the reference pair ($\omega =0.750$ and $0.7603$, $|M_-|/M_+=0.996$) and the domain $L=64$, and starts from rest.}}{6}{table.2}\protected@file@percent }
\newlabel{tab:matrix}{{II}{6}{The 34 simulations. Labels name the stars, P for a positive-mass and M for a negative-mass star, followed by the initial separation $d_0$; E labels equal-mass pairs by $\bar M$ relative to PM20, R unequal-mass pairs by $|M_-|/M_+$, and S isolated stars by $\omega $. Unless stated, a simulation uses the stars of the reference pair ($\omega =0.750$ and $0.7603$, $|M_-|/M_+=0.996$) and the domain $L=64$, and starts from rest}{table.2}{}}
