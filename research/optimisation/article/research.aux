\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Geometry-first versus matter-first search. Dashed: prescribe a metric and infer its stress-energy tensor $T_{\mu \nu }$. Solid: propose a confining potential $\mathcal  {V}(\psi )$ for the phantom field, solve the coupled Einstein--Klein--Gordon equations at fixed $R_e$ and $J$, screen for stability, and verify the winners in full $3{+}1$ nonlinear evolution.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:search}{{1}{3}{Geometry-first versus matter-first search. Dashed: prescribe a metric and infer its stress-energy tensor $T_{\mu \nu }$. Solid: propose a confining potential $\mathcal {V}(\psi )$ for the phantom field, solve the coupled Einstein--Klein--Gordon equations at fixed $R_e$ and $J$, screen for stability, and verify the winners in full $3{+}1$ nonlinear evolution}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Exotic-matter bill $X$ across CMA-ES evaluations for the D21 drainhole on the search grid. Red: accepted candidates passing the identity gates; grey: rejected candidates. Dashed line: massless phantom baseline ($\mathcal  {V}=0$, $X=4.645$). The search-grid minimum ($X=1.785$) settles at $X=1.829$ ($-61\%$) upon finer-grid re-solve (Table~\ref {tab:X}).}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:cma}{{2}{3}{Exotic-matter bill $X$ across CMA-ES evaluations for the D21 drainhole on the search grid. Red: accepted candidates passing the identity gates; grey: rejected candidates. Dashed line: massless phantom baseline ($\mathcal {V}=0$, $X=4.645$). The search-grid minimum ($X=1.785$) settles at $X=1.829$ ($-61\%$) upon finer-grid re-solve (Table~\ref {tab:X})}{figure.2}{}}
