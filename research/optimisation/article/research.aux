\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Three-resolution convergence study of the optimized D21 drainhole evolution over $N=96, 128, 192$. (a)--(d)~Hamiltonian and (e)--(h)~momentum constraint $L_2$ norms per refinement level; dashed and dotted curves show the $N=192$ norm rescaled for second-order ($2^{2}$) and fourth-order ($2^{4}$) convergence. (i)--(l)~Equatorial throat radius drift, areal throat radius drift, $(\ell ,m)=(2,0)$ Newman--Penrose scalar $\Psi _4^{20}$ extracted at $R=14$, and minimum puncture lapse $\alpha _{\min }$. Constraint norms fall systematically with resolution and the throat holds.}}{7}{figure.5}\protected@file@percent }
\newlabel{fig:conv}{{5}{7}{Three-resolution convergence study of the optimized D21 drainhole evolution over $N=96, 128, 192$. (a)--(d)~Hamiltonian and (e)--(h)~momentum constraint $L_2$ norms per refinement level; dashed and dotted curves show the $N=192$ norm rescaled for second-order ($2^{2}$) and fourth-order ($2^{4}$) convergence. (i)--(l)~Equatorial throat radius drift, areal throat radius drift, $(\ell ,m)=(2,0)$ Newman--Penrose scalar $\Psi _4^{20}$ extracted at $R=14$, and minimum puncture lapse $\alpha _{\min }$. Constraint norms fall systematically with resolution and the throat holds}{figure.5}{}}
