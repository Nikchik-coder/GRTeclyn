\newlabel{tab:X}{{II}{5}{Exoticity of the same candidates as Table~\ref {tab:models}, compared with the massless solution at the same $R_e$ and $J$. Here $\Delta X=100(X/X_{\mathcal {V}=0}-1)$. The search-grid rows and the selected finer-grid solution are listed separately}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Measured growth rates at $N=128$: classical models from Ref.~\cite  {shirokov2026s} and the potential-bearing D21$^\star $ (blue star). The dashed curve fits the classical contracting models. Classical D21 has $J=1$ and outer drive strength $1$; D21$^\star $ has $J=1.0138$ and drive strength $0$, with initial equatorial radii differing by about $0.1\%$. Over the same $0.2$--$1\%$ areal-radius decrease, D21$^\star $ has a $31\%$ lower fitted growth rate.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:growth}{{4}{5}{Measured growth rates at $N=128$: classical models from Ref.~\cite {shirokov2026s} and the potential-bearing D21$^\star $ (blue star). The dashed curve fits the classical contracting models. Classical D21 has $J=1$ and outer drive strength $1$; D21$^\star $ has $J=1.0138$ and drive strength $0$, with initial equatorial radii differing by about $0.1\%$. Over the same $0.2$--$1\%$ areal-radius decrease, D21$^\star $ has a $\clmGrowthReduction \%$ lower fitted growth rate}{figure.4}{}}
