\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Convergence of the D21 evolution over $N=96/128/192$. (a)--(d)~Hamiltonian and (e)--(h)~momentum constraint norms per refinement level; dashed and dotted, $N=192$ rescaled by $2^{2}$ and $2^{4}$. (i)--(l)~equatorial throat radius, areal radius, $\Psi _4^{20}$ at $R=14$, and the puncture lapse. Constraint norms fall with resolution; the throat holds.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:conv}{{3}{5}{Convergence of the D21 evolution over $N=96/128/192$. (a)--(d)~Hamiltonian and (e)--(h)~momentum constraint norms per refinement level; dashed and dotted, $N=192$ rescaled by $2^{2}$ and $2^{4}$. (i)--(l)~equatorial throat radius, areal radius, $\Psi _4^{20}$ at $R=14$, and the puncture lapse. Constraint norms fall with resolution; the throat holds}{figure.3}{}}
