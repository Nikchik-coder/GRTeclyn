\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Optimized wormhole models: family, equatorial rotation velocity $v_e$, and the four confining potential parameters of Eq.~\eqref  {eq:kink}. Family (a) is the asymmetric drainhole ($\gamma =-\pi $), and family (b) is the symmetric wormhole ($\gamma =0$). Model D$n$ has $v_e\approx n/100$; S$n$ likewise.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:models}{{I}{4}{Optimized wormhole models: family, equatorial rotation velocity $v_e$, and the four confining potential parameters of Eq.~\eqref {eq:kink}. Family (a) is the asymmetric drainhole ($\gamma =-\pi $), and family (b) is the symmetric wormhole ($\gamma =0$). Model D$n$ has $v_e\approx n/100$; S$n$ likewise}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Exotic-matter integral $X$ of the potential-confined models of Table~\ref {tab:models}, compared against the massless phantom ($\mathcal  {V}=0$) at identical throat radius $R_e$ and angular momentum $J$. Every model passes the four criteria of Sec.~\ref {sec:setup:criteria}.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:X}{{II}{4}{Exotic-matter integral $X$ of the potential-confined models of Table~\ref {tab:models}, compared against the massless phantom ($\mathcal {V}=0$) at identical throat radius $R_e$ and angular momentum $J$. Every model passes the four criteria of Sec.~\ref {sec:setup:criteria}}{table.2}{}}
