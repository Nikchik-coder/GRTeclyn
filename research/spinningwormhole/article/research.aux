\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces The two families at representative spins, in units of $\eta _0$: rotation velocity $v_e$, angular momentum, mass of the $\eta \to +\infty $ end, ratio of end masses, scalar charge, equatorial throat radius, flattening, and throat angular velocity---each read off the solution's functions as defined in Sec.~\ref {sec:model}. Every row is a converged solution that passed the acceptance checks of Sec.~\ref {sec:solver}.}}{6}{table.3}\protected@file@percent }
\newlabel{tab:backgrounds}{{III}{6}{The two families at representative spins, in units of $\eta _0$: rotation velocity $v_e$, angular momentum, mass of the $\eta \to +\infty $ end, ratio of end masses, scalar charge, equatorial throat radius, flattening, and throat angular velocity---each read off the solution's functions as defined in Sec.~\ref {sec:model}. Every row is a converged solution that passed the acceptance checks of Sec.~\ref {sec:solver}}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces The simulations: the drainhole family (a), in code units. Model D$n$ is the drainhole background with $v_e\approx n/100$ (D0: static); D21$\pm \varepsilon $ carries an added radial perturbation $|\varepsilon |=10^{-3}$, outward and inward. $8\pi J/A$ is the angular momentum as a percentage of its extremal value $J_{\rm  ext}=A/8\pi $ at the throat area $A$, and $M_{\rm  ADM}$ the mass of the $\eta \to +\infty $ end (both from the background tables). The finest $\Delta x$ is $0.0625$ at $N=128$ on $L=64$ and at $N=256$ on $L=128$, and scales inversely with $N$ within a triplet. $\sigma $: the Kreiss--Oliger dissipation strength (Sec.~\ref {sec:setup:scheme}); the conformal factor is floored at $10^{-8}$, except at $10^{-4}$ in D75, D80 and D90. Layer: the boundary damping layer of Sec.~\ref {sec:setup:boundary} on, or the background-relative boundary alone (off). Final $t$: the time the run reached, to two significant figures. Table~\ref {tab:results} gives the results, row by row.}}{6}{table.4}\protected@file@percent }
\newlabel{tab:ladder}{{IV}{6}{The simulations: the drainhole family (a), in code units. Model D$n$ is the drainhole background with $v_e\approx n/100$ (D0: static); D21$\pm \varepsilon $ carries an added radial perturbation $|\varepsilon |=10^{-3}$, outward and inward. $8\pi J/A$ is the angular momentum as a percentage of its extremal value $J_{\rm ext}=A/8\pi $ at the throat area $A$, and $M_{\rm ADM}$ the mass of the $\eta \to +\infty $ end (both from the background tables). The finest $\Delta x$ is $0.0625$ at $N=128$ on $L=64$ and at $N=256$ on $L=128$, and scales inversely with $N$ within a triplet. $\sigma $: the Kreiss--Oliger dissipation strength (Sec.~\ref {sec:setup:scheme}); the conformal factor is floored at $10^{-8}$, except at $10^{-4}$ in D75, D80 and D90. Layer: the boundary damping layer of Sec.~\ref {sec:setup:boundary} on, or the background-relative boundary alone (off). Final $t$: the time the run reached, to two significant figures. Table~\ref {tab:results} gives the results, row by row}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Inverse $e$-fold time $1/\tau $ of the throat's areal radius against the angular momentum as a fraction of its extremal value (Table~\ref {tab:results}), beside the second-order rates of Refs.~\cite  {azad2023,azad2024} ($J_c$: the zero of their rate). The rates follow second order at slow spin and fall below it at higher spin; near $30\%$ the unperturbed throat expands instead of collapsing.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:curve}{{4}{6}{Inverse $e$-fold time $1/\tau $ of the throat's areal radius against the angular momentum as a fraction of its extremal value (Table~\ref {tab:results}), beside the second-order rates of Refs.~\cite {azad2023,azad2024} ($J_c$: the zero of their rate). The rates follow second order at slow spin and fall below it at higher spin; near $30\%$ the unperturbed throat expands instead of collapsing}{figure.4}{}}
