\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The solver loop for one family (Sec.~\ref {sec:solver}). Thin boxes impose equations; the heavy box tests identities the solver never imposes, and only it decides acceptance. A failed check refines the grid and solves the same $J$ again; an accepted solution seeds the next $J$. The loop gave 462 accepted solutions over 20 continuation legs, both families to $v_e\approx 0.99$.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:solver}{{1}{4}{The solver loop for one family (Sec.~\ref {sec:solver}). Thin boxes impose equations; the heavy box tests identities the solver never imposes, and only it decides acceptance. A failed check refines the grid and solves the same $J$ again; an accepted solution seeds the next $J$. The loop gave 462 accepted solutions over 20 continuation legs, both families to $v_e\approx 0.99$}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The symmetric family ($\eta _0=1$, $\gamma =0$; 81 solutions, $v_e=0.02$--$0.991$, plus the exact static member) in the normalization of Ref.~\cite  {kleihaus_kunz2014} ($M_0=R_e$, $J_0=R_e^2/2$, $\Omega _0=1/R_e$): our curves, the digitized points of their Fig.~1 (open symbols), and closed-form Kerr (dashed). The digitization's reading error, measured by reading their printed Kerr curves the same way, is rms $1$--$6\times 10^{-4}$; digitized minus ours is rms $2.5$--$8\times 10^{-4}$, max $2.5\times 10^{-3}$, over all five curves. The two solvers agree to the precision a printed figure carries.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:kk2014}{{2}{4}{The symmetric family ($\eta _0=1$, $\gamma =0$; 81 solutions, $v_e=0.02$--$0.991$, plus the exact static member) in the normalization of Ref.~\cite {kleihaus_kunz2014} ($M_0=R_e$, $J_0=R_e^2/2$, $\Omega _0=1/R_e$): our curves, the digitized points of their Fig.~1 (open symbols), and closed-form Kerr (dashed). The digitization's reading error, measured by reading their printed Kerr curves the same way, is rms $1$--$6\times 10^{-4}$; digitized minus ours is rms $2.5$--$8\times 10^{-4}$, max $2.5\times 10^{-3}$, over all five curves. The two solvers agree to the precision a printed figure carries}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Scalar charge $D$ of the anchor solutions ($\eta _0=1$, $\omega _\infty =0.5$) against Ref.~\cite  {chew2016}. Along each fixed-$\gamma $ family, $\omega _\infty $ rises, turns over and descends, so $\omega _\infty =0.5$ is reached twice; the published values sit on the post-turnover branch. Our values are grid-converged to the digits shown; the $\gamma =2$ family continued to $J=172$ confirms no third crossing exists. The pre-turnover branch is new.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:anchors}{{I}{4}{Scalar charge $D$ of the anchor solutions ($\eta _0=1$, $\omega _\infty =0.5$) against Ref.~\cite {chew2016}. Along each fixed-$\gamma $ family, $\omega _\infty $ rises, turns over and descends, so $\omega _\infty =0.5$ is reached twice; the published values sit on the post-turnover branch. Our values are grid-converged to the digits shown; the $\gamma =2$ family continued to $J=172$ confirms no third crossing exists. The pre-turnover branch is new}{table.1}{}}
