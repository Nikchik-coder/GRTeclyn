\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces The two families at representative spins, in units of $\eta _0$ ($G=c=1$): rotation velocity $v_e$, angular momentum, mass of the $\eta \to +\infty $ end, ratio of end masses, scalar charge, equatorial throat radius, flattening, and throat angular velocity---each read off the solution's functions as defined in Sec.~\ref {sec:model}. Every row is a converged solution with the acceptance gates of Sec.~\ref {sec:solver} (unimposed identities at the $10^{-9}$ level or better); family (b) is evolved after the rescale $\eta _0\to 2$. The published record covers family (b) only, as curves~\cite  {kleihaus_kunz2014,chew2016}; the massive family (a) is mapped here for the first time.}}{6}{table.1}\protected@file@percent }
\newlabel{tab:backgrounds}{{I}{6}{The two families at representative spins, in units of $\eta _0$ ($G=c=1$): rotation velocity $v_e$, angular momentum, mass of the $\eta \to +\infty $ end, ratio of end masses, scalar charge, equatorial throat radius, flattening, and throat angular velocity---each read off the solution's functions as defined in Sec.~\ref {sec:model}. Every row is a converged solution with the acceptance gates of Sec.~\ref {sec:solver} (unimposed identities at the $10^{-9}$ level or better); family (b) is evolved after the rescale $\eta _0\to 2$. The published record covers family (b) only, as curves~\cite {kleihaus_kunz2014,chew2016}; the massive family (a) is mapped here for the first time}{table.1}{}}
