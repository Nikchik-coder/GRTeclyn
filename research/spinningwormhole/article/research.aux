\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces Results of the simulations of Table~\ref {tab:ladder}, row by row. $t_{\rm  conv}$: the time up to which the run is converged; nothing later is quoted, in the text or the figures. $t_{1\%}$: when the throat's areal radius first departs from its initial value by $1\%$. $\tau $: the $e$-fold time of the unstable mode (Sec.~\ref {sec:slow}). GW: the $(2,0)$ burst at $R=14$ arrives before $t_{\rm  conv}$ (burst), is still rising at $t_{\rm  conv}$ (onset), or stays below the extraction floor (none). MOTS: the marginally outer-trapped surface.}}{8}{table.5}\protected@file@percent }
\newlabel{tab:results}{{V}{8}{Results of the simulations of Table~\ref {tab:ladder}, row by row. $t_{\rm conv}$: the time up to which the run is converged; nothing later is quoted, in the text or the figures. $t_{1\%}$: when the throat's areal radius first departs from its initial value by $1\%$. $\tau $: the $e$-fold time of the unstable mode (Sec.~\ref {sec:slow}). GW: the $(2,0)$ burst at $R=14$ arrives before $t_{\rm conv}$ (burst), is still rising at $t_{\rm conv}$ (onset), or stays below the extraction floor (none). MOTS: the marginally outer-trapped surface}{table.5}{}}
