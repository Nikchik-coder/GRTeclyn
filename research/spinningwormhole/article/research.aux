\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The drainhole ($\eta _0=2$, $\gamma =-\pi $) and symmetric ($\eta _0=1$, $\gamma =0$) families across the spin range, against $v_e$: (a) the mass $M=\mu _+$ of the $\eta \to +\infty $ end, the angular momentum and the equatorial throat radius; (b) $J/M^2$ against the Kerr bound; (c) the ratio of end masses; (d) the flattening $R_p/R_e$; (e) the exotic matter, the phantom field's integrated null-energy violation $\mathcal  {I}=\DOTSI \intop \ilimits@ (\rho +p_\eta )\,dV$ over the $t=\,$const slice~\cite  {visser2003} ($\rho $: energy density, $p_\eta $: radial pressure), per equatorial throat radius, with the 3D runs (squares) placed by the scalar charge measured on each run's own $t=0$ slice, which reproduces its background's to $3\times 10^{-4}$; (f) the throat angular velocity, which peaks and falls to zero at extremality. Both families end on extremal Kerr.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:trends}{{3}{5}{The drainhole ($\eta _0=2$, $\gamma =-\pi $) and symmetric ($\eta _0=1$, $\gamma =0$) families across the spin range, against $v_e$: (a) the mass $M=\mu _+$ of the $\eta \to +\infty $ end, the angular momentum and the equatorial throat radius; (b) $J/M^2$ against the Kerr bound; (c) the ratio of end masses; (d) the flattening $R_p/R_e$; (e) the exotic matter, the phantom field's integrated null-energy violation $\mathcal {I}=\int (\rho +p_\eta )\,dV$ over the $t=\,$const slice~\cite {visser2003} ($\rho $: energy density, $p_\eta $: radial pressure), per equatorial throat radius, with the 3D runs (squares) placed by the scalar charge measured on each run's own $t=0$ slice, which reproduces its background's to $3\times 10^{-4}$; (f) the throat angular velocity, which peaks and falls to zero at extremality. Both families end on extremal Kerr}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces The two families at representative spins, in units of $\eta _0$: rotation velocity $v_e$, angular momentum, mass of the $\eta \to +\infty $ end, ratio of end masses, scalar charge, equatorial throat radius, flattening, and throat angular velocity---each read off the solution's functions as defined in Sec.~\ref {sec:model}. Every row is a converged solution that passed the acceptance checks of Sec.~\ref {sec:solver}.}}{5}{table.3}\protected@file@percent }
\newlabel{tab:backgrounds}{{III}{5}{The two families at representative spins, in units of $\eta _0$: rotation velocity $v_e$, angular momentum, mass of the $\eta \to +\infty $ end, ratio of end masses, scalar charge, equatorial throat radius, flattening, and throat angular velocity---each read off the solution's functions as defined in Sec.~\ref {sec:model}. Every row is a converged solution that passed the acceptance checks of Sec.~\ref {sec:solver}}{table.3}{}}
