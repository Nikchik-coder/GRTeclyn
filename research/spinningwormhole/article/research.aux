\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Convergence of the 0.2c rung over its triplet $N=96/128/192$ ($L=64$; finest $\Delta x$ in each panel title). (a)--(d)~Hamiltonian and (e)--(h)~momentum constraint norms per refinement level; dashed and dotted, the $N=192$ norms rescaled by $2^{2}$ and $2^{4}$: the measured $N=96$ norms lie between the second- and fourth-order brackets on every level while the collapse grows. (i)~The equatorial throat radius against the stationary solution, falling with resolution. (j)~The collapse, each run aligned at its own $10\%$ time: the three resolutions land on one curve. (k)~$r\,\Delta \psi _4^{20}$ at $R=14$, aligned: $N=128$ and 192 overlap ($N=96$ dies in its collapse before the burst arrives). (l)~The MOTS radius, aligned: one horizon, settling at $R=2.52$. The outcome: the collapse rate, the waveform and the horizon are grid-converged at third to fourth order.}}{9}{figure.6}\protected@file@percent }
\newlabel{fig:conv02}{{6}{9}{Convergence of the 0.2c rung over its triplet $N=96/128/192$ ($L=64$; finest $\Delta x$ in each panel title). (a)--(d)~Hamiltonian and (e)--(h)~momentum constraint norms per refinement level; dashed and dotted, the $N=192$ norms rescaled by $2^{2}$ and $2^{4}$: the measured $N=96$ norms lie between the second- and fourth-order brackets on every level while the collapse grows. (i)~The equatorial throat radius against the stationary solution, falling with resolution. (j)~The collapse, each run aligned at its own $10\%$ time: the three resolutions land on one curve. (k)~$r\,\Delta \psi _4^{20}$ at $R=14$, aligned: $N=128$ and 192 overlap ($N=96$ dies in its collapse before the burst arrives). (l)~The MOTS radius, aligned: one horizon, settling at $R=2.52$. The outcome: the collapse rate, the waveform and the horizon are grid-converged at third to fourth order}{figure.6}{}}
