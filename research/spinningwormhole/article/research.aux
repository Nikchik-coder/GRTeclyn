\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Convergence of the D21 model over its triplet $N=96/128/192$ ($L=64$; finest $\Delta x$ in each panel title). (a)--(d)~Hamiltonian and (e)--(h)~momentum constraint norms per refinement level; dashed and dotted, the $N=192$ norms rescaled by $2^{2}$ and $2^{4}$: the measured $N=96$ norms lie between the second- and fourth-order brackets on every level while the collapse grows. (i)~The equatorial throat radius against the stationary solution, falling with resolution. (j)~The collapse, each run aligned at its own $10\%$ time: the three resolutions land on one curve. (k)~$r\,\Delta \psi _4^{20}$ at $R=14$, aligned: $N=128$ and 192 overlap ($N=96$ dies in its collapse before the burst arrives). (l)~The MOTS radius, aligned: one horizon, settling at $R=2.52$. The collapse rate self-converges at third to fourth order ($Q=2.3$); the waveform and the horizon agree across resolutions.}}{10}{figure.6}\protected@file@percent }
\newlabel{fig:conv02}{{6}{10}{Convergence of the D21 model over its triplet $N=96/128/192$ ($L=64$; finest $\Delta x$ in each panel title). (a)--(d)~Hamiltonian and (e)--(h)~momentum constraint norms per refinement level; dashed and dotted, the $N=192$ norms rescaled by $2^{2}$ and $2^{4}$: the measured $N=96$ norms lie between the second- and fourth-order brackets on every level while the collapse grows. (i)~The equatorial throat radius against the stationary solution, falling with resolution. (j)~The collapse, each run aligned at its own $10\%$ time: the three resolutions land on one curve. (k)~$r\,\Delta \psi _4^{20}$ at $R=14$, aligned: $N=128$ and 192 overlap ($N=96$ dies in its collapse before the burst arrives). (l)~The MOTS radius, aligned: one horizon, settling at $R=2.52$. The collapse rate self-converges at third to fourth order ($Q=2.3$); the waveform and the horizon agree across resolutions}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Stability of the D90 model over its triplet $N=128/192/256$ ($L=128$; finest $\Delta x$ in each panel title), to $t=150$. (a)--(h)~Constraint norms per level with the same second-/fourth-order brackets as Fig.~\ref {fig:conv02}: every level converges with resolution over the run. (i)~The equatorial throat radius holds the stationary value, its offset falling with resolution. (j)~The areal throat radius drifts by $\le 7\times 10^{-5}$ over the full run. (k)~The $(2,0)$ extraction at $R=18$, relative to its $t=0$ read-off: fluctuations at the $10^{-4}$ level, no burst. (l)~The lapse at the $\eta \to -\infty $ puncture falls smoothly at all three resolutions (the gauge, not the geometry). The D90 throat shows no growing radius and no wave at any resolution over the run, with constraint norms converging.}}{10}{figure.7}\protected@file@percent }
\newlabel{fig:conv09}{{7}{10}{Stability of the D90 model over its triplet $N=128/192/256$ ($L=128$; finest $\Delta x$ in each panel title), to $t=150$. (a)--(h)~Constraint norms per level with the same second-/fourth-order brackets as Fig.~\ref {fig:conv02}: every level converges with resolution over the run. (i)~The equatorial throat radius holds the stationary value, its offset falling with resolution. (j)~The areal throat radius drifts by $\le 7\times 10^{-5}$ over the full run. (k)~The $(2,0)$ extraction at $R=18$, relative to its $t=0$ read-off: fluctuations at the $10^{-4}$ level, no burst. (l)~The lapse at the $\eta \to -\infty $ puncture falls smoothly at all three resolutions (the gauge, not the geometry). The D90 throat shows no growing radius and no wave at any resolution over the run, with constraint norms converging}{figure.7}{}}
